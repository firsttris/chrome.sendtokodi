# npm 12 refuses tarball URLs with allow-remote=none (its new default). When it writes only the lock
# file (npm install --package-lock-only, which is how Renovate updates it), it opens packages with
# bundled dependencies through their registry URL, such as @tailwindcss/oxide-wasm32-wasi, and
# stops with EALLOWREMOTE (npm/cli, workspaces/arborist/lib/arborist/build-ideal-tree.js,
# "crackOpen"). "root" is not enough for that; "all" is how npm 11 behaves.
allow-remote=all
