{
  "name": "sendtokodi",
  "version": "0.0.50",
  "type": "module",
  "description": "send almost every stream from chrome to kodi with SendToKodi",
  "scripts": {
    "build": "vite build",
    "build:firefox": "TARGET_PLATFORM=firefox vite build",
    "start": "vite",
    "start:firefox": "TARGET_PLATFORM=firefox vite",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@crxjs/vite-plugin": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "solid-js": "^1.9.15"
  },
  "engines": {
    "node": ">=22.12"
  }
}
