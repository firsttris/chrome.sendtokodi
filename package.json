{
  "name": "sendtokodi",
  "version": "0.0.52",
  "type": "module",
  "description": "send almost every stream from chrome to kodi with SendToKodi",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun --bun vite build",
    "build:firefox": "TARGET_PLATFORM=firefox bun --bun vite build",
    "start": "bun --bun vite",
    "start:firefox": "TARGET_PLATFORM=firefox bun --bun vite",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "bun --bun vitest run",
    "typecheck": "tsc -p .",
    "release:patch": "bun pm version patch",
    "release:minor": "bun pm version minor",
    "release:major": "bun pm version major",
    "postversion": "git push --follow-tags",
    "screenshots": "bun --bun playwright test -c playwright.screenshots.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "solid-js": "^1.9.15"
  }
}
